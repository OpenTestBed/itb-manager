# ITB connection (from itb-starter)
VITE_ITB_BASE_URL=http://localhost:10003
VITE_ITB_DEPLOY_PATH=/api/rest/testsuite/deploy

# API keys — get these from ITB after first login
# ITB > Community management > API key
VITE_ITB_COMMUNITY_API_KEY=
# ITB > Organisation > API key
VITE_ITB_ORGANISATION_API_KEY=
# ITB > System > API key
VITE_ITB_SYSTEM_API_KEY=
# ITB > Specification > API key
VITE_ITB_SPECIFICATION_ID=

# Docker MySQL container name (for "Open in ITB" links)
# Must match the container name from your docker-compose
ITB_MYSQL_CONTAINER=itb-starter-gitb-mysql-1
ITB_MYSQL_USER=root
ITB_MYSQL_PASSWORD=root
ITB_MYSQL_DATABASE=gitb
